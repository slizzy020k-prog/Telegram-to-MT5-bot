# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=copier_session
ALLOW_FORWARDS=false

# Monitored Telegram Channel IDs
CHANNEL_IDS=[-1001234567890]

# Core Trading Settings (Multiple concurrent signals enabled)
MAGIC_NUMBER=777001
DEFAULT_SYMBOL=XAUUSD.s
SINGLE_PRICE_LOT=0.01
CHECK_ALGO_TRADING_INTERVAL=30
IGNORED_SYMBOLS=["EURUSD", "GBPUSD", "USDJPY", "GBPJPY", "US30", "NAS100", "USTEC", "BTCUSD"]
LAYER_LOTS={"TOP": 0.01, "MID": 0.01, "BOTTOM": 0.02}
MAX_ORDERS_PER_SIGNAL=3

# Front-Run TP & Proximity Close Settings
TP_FRONT_RUN_OFFSET=0.50
TP1_CLOSE_PROXIMITY_PIPS=20

# Breakeven & Protective Buffers
BE_LAYERS=["TOP", "MID"]
BE_OFFSET_PIPS=2.0
ALLOW_BELOW_ZONE_WICK=true
MIN_SL_BUFFER_PIPS=20
FALLBACK_SL_PIPS=150
MAX_SL_PIPS=350

# Notifications & Execution Mode
NOTIFY_SAVED_MESSAGES=true
DRY_RUN=false
DEDUPLICATION_WINDOW_SECONDS=5

# Seconds to hold an unpriced "Sell now" waiting for the provider to post limits/zone (0 = execute at once)
SELL_NOW_DELAY_SECONDS=0
MAX_NEW_EDIT_AGE_SECONDS=180
FALLBACK_TP1_PIPS=50
UNPRICED_TP_GRACE_SECONDS=45
ENFORCE_HIGH_RISK_LOT_CAP=true
DAILY_LOSS_PAUSE_PCT=50.0
EMERGENCY_CUTOFF_LOSS_PCT=90.0

# Uptime & System Overhead Controls
PREVENT_SYSTEM_SLEEP=true
IDLE_MT5_POLL_INTERVAL_SECONDS=5.0
TELEGRAM_KEEPALIVE_SECONDS=20.0
CONSOLE_TITLE_UPDATES=true
