# ===========================================================================
# STRATEGY & 4-LAYER ACTIVE RUNNER CONFIGURATION (v3.1)
# ===========================================================================
# Base 4-layer lot split: all layers initially enter at TP1; deepest dynamic
# runner(s) step upward through TP1 -> TP2 -> TP3 -> TP4 (or TP5).
BASE_LAYER_LOTS=[0.02, 0.02, 0.02, 0.02]
RISK_LOT_MULTIPLIER=1.0
LAYER_LOTS={"L1": 0.02, "L2": 0.02, "L3": 0.02, "L4": 0.02}
MAX_ORDERS_PER_SIGNAL=1

# TP1 Front-Run & TP1-TP5 Deterministic Extension Steps (pips; 100 = $10 on XAUUSD)
TP_FRONT_RUN_OFFSET=0.50
DEFAULT_TP_STEP_PIPS=100.0
TP2_STEP_PIPS=100.0
TP3_STEP_PIPS=100.0
TP4_STEP_PIPS=100.0
TP5_STEP_PIPS=100.0

# Spread Guards & Runner Stage Configuration
M1_ATR_PERIOD=14
MAX_ALLOWED_SPREAD_DOLLARS=0.40
ADAPTIVE_SPREAD_CEILING_DOLLARS=0.80
ADAPTIVE_SPREAD_MULTIPLIER=1.50
RUNNER_DEEPEST_COUNT_FULL=1
RUNNER_MAX_TP_STAGE=5

# TP1 Scaling & All-Layer Breakeven (all active layers L1..L4 move to BE when breakeven is called)
CANCEL_PENDING_ON_TP1=true
BE_AFTER_TP1=true
BE_LAYERS=["L1", "L2", "L3", "L4"]
BE_OFFSET_PIPS=12.0

# Auto Market Entry Slippage: activate bare "BUY/SELL <price>" at market if within 15 pips ($1.50)
AUTO_MARKET_SLIPPAGE_PIPS=15.0

# ===========================================================================
# RECONNECT CATCH-UP, DELETED-SIGNAL PROTECTION, ACCOUNTING & LEDGER (v3.2)
# ===========================================================================
CATCHUP_WINDOW_SECONDS=1800
CATCHUP_MAX_MESSAGES=25
CATCHUP_MARKET_MAX_AGE_SECONDS=60
CATCHUP_MARKET_MAX_SLIPPAGE_PIPS=15.0
CLOSE_ON_SIGNAL_DELETED=true
DELETED_SIGNAL_POLL_INTERVAL_SECONDS=1.5
DAILY_PNL_CACHE_TTL_SECONDS=5.0

# Leave blank to use defaults inside project root (signals_state.json, copier.log, trades_ledger.jsonl, copier.lock)
STATE_FILE_PATH=
LOG_FILE_PATH=
TRADES_LEDGER_PATH=
LOCK_FILE_PATH=

# ===========================================================================
# TELEGRAM API CREDENTIALS & MONITORED CHANNELS
# ===========================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=copier_session
ALLOW_FORWARDS=false
CHANNEL_IDS=[-1001234567890]

# ===========================================================================
# BROKER SYMBOL, SL/TP SAFETY & RISK GUARDS
# ===========================================================================
MAGIC_NUMBER=777001
DEFAULT_SYMBOL=XAUUSD.s
SINGLE_PRICE_LOT=0.02
CHECK_ALGO_TRADING_INTERVAL=30
IGNORED_SYMBOLS=["EURUSD", "GBPUSD", "USDJPY", "GBPJPY", "US30", "NAS100", "USTEC", "BTCUSD"]

ALLOW_BELOW_ZONE_WICK=true
MIN_SL_BUFFER_PIPS=20
FALLBACK_SL_PIPS=150
MAX_SL_PIPS=350
FALLBACK_TP1_PIPS=50
UNPRICED_TP_GRACE_SECONDS=45
# Risk & Loss Caps — disabled (unlimited) by default; toggle live via Saved Messages (/lotcap, /losslimit, /floatcap)
ENFORCE_HIGH_RISK_LOT_CAP=false
AUTO_ADJUST_LOTS_TO_BALANCE=false
DAILY_LOSS_PAUSE_PCT=0.0
EMERGENCY_CUTOFF_LOSS_PCT=0.0
FLOAT_LOSS_FORCE_CLOSE_PCT=0.0
DAILY_LOSS_CLOSE_OPEN_TRADES=false

# ===========================================================================
# DELAYED ENTRY, LEGACY RUNNER THRESHOLDS & RUNTIME CONTROLS
# ===========================================================================
TP1_CLOSE_PROXIMITY_PIPS=20
TP1_LOCK_BUFFER=0.50
TRAIL_DISTANCE_PIPS=15.0
TRAIL_STEP_PIPS=5.0
TP2_SHORTFALL_ARM_PIPS=20.0
TP2_SHORTFALL_PULLBACK_PIPS=8.0
NO_TP2_SURGE_ARM_PIPS=40.0

SELL_NOW_DELAY_SECONDS=0
DELAYED_POLL_INTERVAL_SECONDS=0.25
NOW_PRICE_GUARD_ABORT_ON_MISMATCH=true
NOW_ENTRY_MAX_WAIT_SECONDS=180
MAX_NEW_EDIT_AGE_SECONDS=3600
MAX_EDIT_EVENT_FRESHNESS_SECONDS=180
DEDUPLICATION_WINDOW_SECONDS=5

NOTIFY_SAVED_MESSAGES=true
DRY_RUN=false
PREVENT_SYSTEM_SLEEP=true
IDLE_MT5_POLL_INTERVAL_SECONDS=5.0
TELEGRAM_KEEPALIVE_SECONDS=20.0
CONSOLE_TITLE_UPDATES=true

# Optional Direct MT5 Login Overrides
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_PATH=
# Opt-in to allow boot with MT5_LOGIN unset in live mode (identity unverified).
# Default false = the startup preflight hard-halts on unverified identity.
# MT5_PREFLIGHT_ALLOW_UNVERIFIED_LOGIN=false

# ===========================================================================
# PURE DYNAMIC ATR ENGINE (ATR-SCALED SL/TP, BE LOCK & TRAILING SL/TP)
# ===========================================================================
DYNAMIC_ATR_SLTP_ENABLED=true
DYNAMIC_SLTP_MODE=ADAPTIVE
DYNAMIC_ATR_TIMEFRAME=M5
DYNAMIC_ATR_PERIOD=14
DYNAMIC_ATR_BASELINE_DOLLARS=4.00
DYNAMIC_SL_ATR_MULT=2.50
DYNAMIC_TP_ATR_MULT=1.50
DYNAMIC_TP_STEP_ATR_MULT=1.50
DYNAMIC_SL_MIN_DOLLARS=4.50
DYNAMIC_SL_MAX_DOLLARS=35.00
DYNAMIC_TP_MIN_DOLLARS=2.50
DYNAMIC_TP_MAX_DOLLARS=50.00
DYNAMIC_SLTP_SCALE_MIN=0.75
DYNAMIC_SLTP_SCALE_MAX=1.75

# Dynamic ATR Trailing Stop, BE Lock & Trailing TP
# Progressive ATR trail (Msg 10196 peak protection), v3.9.0 per-stage clamps:
#   MFE <  $10/oz -> 1.40x M5_ATR clamp [$2.50, $8.00]
#   $10 <= MFE < $18 -> 1.00x clamp [$2.20, $5.50] | >= $18 -> 0.80x clamp [$2.00, $4.00]
DYNAMIC_ATR_TRAIL_ENABLED=true
DYNAMIC_ATR_TRAIL_TIMEFRAME=M5
DYNAMIC_ATR_TRAIL_MULT=1.40
DYNAMIC_ATR_TRAIL_EXTENDED_MFE_DOLLARS=10.00
DYNAMIC_ATR_TRAIL_EXTENDED_MULT=1.00
DYNAMIC_ATR_TRAIL_HOMERUN_MFE_DOLLARS=18.00
DYNAMIC_ATR_TRAIL_HOMERUN_MULT=0.80
DYNAMIC_ATR_TRAIL_ACTIVATION_MULT=1.00
DYNAMIC_ATR_TRAIL_MIN_DOLLARS=2.50
DYNAMIC_ATR_TRAIL_MAX_DOLLARS=8.00
DYNAMIC_ATR_TRAIL_EXTENDED_MIN_DOLLARS=2.20
DYNAMIC_ATR_TRAIL_EXTENDED_MAX_DOLLARS=5.50
DYNAMIC_ATR_TRAIL_HOMERUN_MIN_DOLLARS=2.00
DYNAMIC_ATR_TRAIL_HOMERUN_MAX_DOLLARS=4.00
DYNAMIC_ATR_TRAIL_STEP_DOLLARS=0.25

# Selectable trailing profile (baseline|t2|t3) from the validated A/B research.
# baseline is the SHIPPED production default (ACTIVATION 1.00 / MAX 8.00 above).
#   t2 = ACTIVATION_MULT 1.00 + MAX_DOLLARS 5.50 (Pareto-safe fallback)
#   t3 = ACTIVATION_MULT 0.70 + MAX_DOLLARS 5.50 (leading config)
# The profile overrides ONLY DYNAMIC_ATR_TRAIL_ACTIVATION_MULT and
# DYNAMIC_ATR_TRAIL_MAX_DOLLARS after parsing; all other trail knobs are unchanged.
# Invalid/empty values fall back to baseline.
TRAILING_PROFILE=baseline

DYNAMIC_ATR_BE_ACTIVATION_MULT=0.50
DYNAMIC_ATR_BE_MIN_MFE_DOLLARS=0.60
DYNAMIC_ATR_BE_LOCK_OFFSET_DOLLARS=1.20
# The BE lock arms on max(0.25 * R, 0.50 * ATR, $0.60, $1.20 + $0.60).
DYNAMIC_ATR_BE_R_ACTIVATION_MULT=0.25

DYNAMIC_ATR_TP_TRAIL_ENABLED=true
DYNAMIC_ATR_TP_LIFT_ATR_MULT=0.50
DYNAMIC_ATR_TP_LIFT_PROGRESS_PCT=0.75
# Minimum leg progress before a 0.50x ATR proximity lift may step TP1 -> TP2
# (or the position must already be BE-locked).
DYNAMIC_ATR_TP1_LIFT_MIN_PROGRESS_PCT=0.50

# R-Relative Profit Floor (R lock)
# Ships DISABLED. Enable live from Saved Messages: /rlock on.
R_LOCK_ENABLED=false
R_LOCK_TIERS=0.5:0.00,1.0:0.25,1.5:0.50,2.0:0.75
R_LOCK_MIN_R_DOLLARS=0.50

# --- 2026-11-27: spread-safe BE arming + lock floor + TP1 guard ---
DYNAMIC_ATR_BE_MIN_DISTANCE_DOLLARS=0.60
DYNAMIC_ATR_MFE_LOCK_COST_FLOOR_DOLLARS=1.00
MIN_TP1_SPREAD_MULTIPLE=3.0
